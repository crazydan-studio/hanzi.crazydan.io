{
  "name": "hanzi-stroke",
  "version": "1.0.0",
  "description": "汉字笔画书写录制与演示系统",
  "scripts": {
    "dev": "pnpm web:font && vite",
    "dev:all": "pnpm web:font && node build/dev-all.js",
    "build": "pnpm web:font && vite build",
    "seed": "node --disable-warning=ExperimentalWarning server/scripts/seed.js",
    "web:font": "node --disable-warning=ExperimentalWarning build/web-font-pack.js",
    "import:pinyin": "node --disable-warning=ExperimentalWarning server/scripts/import-pinyin.js",
    "audio:pack": "node --disable-warning=ExperimentalWarning build/audio-pack.js",
    "export:zi": "node --disable-warning=ExperimentalWarning build/export-zi.js",
    "export:stroke-db": "node --disable-warning=ExperimentalWarning build/export-stroke-db.js",
    "app:version": "node --disable-warning=ExperimentalWarning build/app-version-pack.js",
    "server:dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "server:build": "esbuild server/index.js --bundle --platform=node --format=cjs --outfile=server/dist/index.cjs --minify --log-level=warning"
  },
  "dependencies": {
    "alpinejs": "^3.13.0",
    "express": "^4.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "esbuild": "0.21.5",
    "fontkit": "^2.0.4",
    "fontverter": "^2.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  }
}
