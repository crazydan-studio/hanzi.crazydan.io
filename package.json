{
  "name": "hanzi-stroke",
  "version": "1.0.0",
  "type": "module",
  "description": "汉字笔画书写与存储系统",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:all": "node build/dev-all.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/scripts/seed.js",
    "import:pinyin": "node --disable-warning=ExperimentalWarning server/scripts/import-pinyin.js",
    "export:data": "node --disable-warning=ExperimentalWarning build/export-data.js",
    "export:stroke-db": "node --disable-warning=ExperimentalWarning build/export-stroke-db.js"
  },
  "dependencies": {
    "alpinejs": "^3.13.0",
    "express": "^4.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  }
