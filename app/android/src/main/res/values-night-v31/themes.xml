<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+（API 31）暗色: 完整样式 + 系统启动画面（SplashScreen）背景与暗色主题一致 -->
    <style name="Theme.Hanzi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@color/window_background_dark</item>
        <item name="android:navigationBarColor">@color/window_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/window_background_dark</item>
    </style>
</resources>
